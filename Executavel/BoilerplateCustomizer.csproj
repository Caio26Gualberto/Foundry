<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<PublishReadyToRun>true</PublishReadyToRun>

		<AssemblyTitle>Boilerplate Customizer</AssemblyTitle>
		<AssemblyDescription>Executable for boilerplate customization</AssemblyDescription>

		<Version>0.1.0</Version>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
  </ItemGroup>

  <!-- Exclude Templates folder from compilation and output entirely -->
  <ItemGroup>
    <None Remove="Templates\**" />
    <Content Remove="Templates\**" />
    <Compile Remove="Templates\**" />
    <EmbeddedResource Remove="Templates\**" />
  </ItemGroup>

  <!-- Embed the generated templates.zip -->
  <ItemGroup>
    <EmbeddedResource Include="templates.zip">
      <LogicalName>templates.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Zip the Templates folder before build -->
  <Target Name="ZipTemplates" BeforeTargets="BeforeBuild">
    <Delete Files="$(ProjectDir)templates.zip" Condition="Exists('$(ProjectDir)templates.zip')" />
    <ZipDirectory SourceDirectory="$(ProjectDir)Templates" DestinationFile="$(ProjectDir)templates.zip" Overwrite="true" />
  </Target>

  <!-- Clean up templates.zip on clean -->
  <Target Name="CleanTemplatesZip" AfterTargets="Clean">
    <Delete Files="$(ProjectDir)templates.zip" Condition="Exists('$(ProjectDir)templates.zip')" />
  </Target>

</Project>
